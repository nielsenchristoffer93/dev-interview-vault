# Git ignore for dev-interview-vault

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editors
.idea/
*.iml
.vscode/
*.swp
*.swo

# Build & Dependency Directories
target/
build/
bin/
out/
node_modules/
dist/
.next/
.turbo/

# Java / JVM
*.class
*.jar
*.war
*.ear
*.hprof
hs_err_pid*

# Logs & Environment
*.log
.env
.env.local
.env.*.local

# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Docker
volumes/
.docker/

# Agent IDE files
.agents/
skills-lock.json

# Exports & AI Notebook dumps
notebook-export/
*-export/

